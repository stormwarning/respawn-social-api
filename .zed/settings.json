{
	"lsp": {
		"deno": {
			"settings": {
				"deno": {
					"enable": true
				}
			}
		},
		"oxlint": {
			"initialization_options": {
				"settings": {
					"configPath": null,
					"run": "onType",
					"disableNestedConfig": false,
					"fixKind": "safe_fix",
					"typeAware": true,
					"unusedDisableDirectives": "deny"
				}
			}
		},
		"oxfmt": {
			"initialization_options": {
				"settings": {
					"fmt.configPath": null
				}
			}
		}
	},
	"languages": {
		"JavaScript": {
			"language_servers": ["deno", "!typescript-language-server", "!vtsls", "!eslint"],
			"formatter": "language_server"
		},
		"TypeScript": {
			"language_servers": ["deno", "!typescript-language-server", "!vtsls", "!eslint"],
			"format_on_save": "on",
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"TSX": {
			"language_servers": ["deno", "!typescript-language-server", "!vtsls", "!eslint"],
			"formatter": "language_server"
		}
	}
}
