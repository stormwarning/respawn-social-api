# ---- Server ----
PORT=8000
# Comma-separated list of front-end origins allowed to call this API (CORS).
# In dev this is your Vite/SvelteKit/static server. In prod, your real domain.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Database ----
# Local dev example. On Fly/Railway this is injected for you.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/respawn

# ---- IGDB / Twitch ----
# Create these at https://dev.twitch.tv/console/apps (Client Type: Confidential).
# IGDB authenticates via Twitch OAuth using these.
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Max IGDB requests/second for this process (default 3; IGDB's global limit is 4).
# Lower to 1 when running `deno task db:backfill` against a database a live
# server is also serving — the two processes share one IGDB budget.
IGDB_RATE_CAP=3

# ---- Freshness ----
# Webhooks are OFF unless this is true. IGDB cannot deliver to localhost, and
# five failed deliveries deactivate a webhook — so leave this false in dev.
IGDB_WEBHOOKS_ENABLED=false
# The externally reachable origin IGDB should POST to. Required when enabled.
PUBLIC_URL=https://api.example.com
# Shared secret IGDB echoes back in X-Secret. 16+ chars, random, a real secret.
IGDB_WEBHOOK_SECRET=change_me_to_something_random

# Run the nightly dump load in-process. Off in dev so a laptop does not pull
# 700MB overnight.
DUMP_SCHEDULE_ENABLED=false
# UTC hour to load dumps at.
DUMP_LOAD_HOUR=6

# The derive worker drains dirty_titles. Safe to leave on: with nothing dirty
# it sleeps on LISTEN.
DERIVE_WORKER_ENABLED=true
